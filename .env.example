# Copy to .env (gitignored) and adjust. Values below are dev placeholders only.
DATABASE_URL=postgres://handlive:handlive-dev@127.0.0.1:55432/handlive_relay
REDIS_URL=redis://127.0.0.1:56379
# HS256 signing key for device JWTs, at least 32 bytes. Generate a real one with:
#   openssl rand -base64 48
RELAY_JWT_SECRET=dev-only-placeholder-change-me-0123456789abcdef
RELAY_BIND=127.0.0.1:8080
RUST_LOG=info
# Push providers (optional). Point at key files kept outside the repository;
# never commit them. Leave unset to run without push.
# RELAY_APNS_KEY_PATH=/run/secrets/AuthKey_XXXXXXXXXX.p8
# RELAY_APNS_KEY_ID=XXXXXXXXXX
# RELAY_APNS_TEAM_ID=XXXXXXXXXX
# RELAY_APNS_TOPIC=app.handlive.ios
# RELAY_FCM_PROJECT_ID=your-firebase-project
# RELAY_FCM_SERVICE_ACCOUNT_PATH=/run/secrets/fcm-service-account.json
